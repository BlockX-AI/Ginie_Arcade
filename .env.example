# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ginix_arcade"

# Backend Signer — Solana keypair (base58 string or JSON byte array).
# Authorizes scores and NFT mints, and pays the fee for every player NFT mint.
# Generated by scripts/initialize-platform.ts. Keep this secret; use a secrets
# manager in production, never commit it.
BACKEND_SIGNER_KEY=your_backend_private_key_here

# Solana Configuration
NEXT_PUBLIC_SOLANA_PROGRAM_ID=3i6fdSaw459wViBFYQjEbw3fdRk1KgANaDmBLMVhbjN7
NEXT_PUBLIC_SOLANA_NFT_PROGRAM_ID=8ko2Z2MZt5LDdRvqSEY2Rc38cLQU7j4edgBA68AA62mU
NEXT_PUBLIC_SOLANA_TOURNAMENT_PROGRAM_ID=2aT2nkWc7kxpVciBnXtZvkfWcwD7WGiDG81t6TTDTWu5
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_BACKEND_SIGNER_KEY=your_backend_public_key_here
NEXT_PUBLIC_REWARD_MINT=your_reward_mint_pubkey_here

# App Configuration
#
# IMPORTANT: this URL is written into NFT metadata, which is IMMUTABLE once minted.
# It must be a public, permanent domain that already serves /api/metadata/* —
# otherwise every minted NFT points at a dead URL forever.
#
# Minting is refused when this is localhost, or when /api/metadata/* does not
# respond successfully. Leave it as localhost for normal local development; NFT
# minting will simply be skipped.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Escape hatches for the two NFT metadata safety checks. Leave unset in production.
#   ALLOW_LOCAL_NFT_METADATA   mint even though the URI is a local host
#   SKIP_NFT_METADATA_PREFLIGHT  mint without checking the URI resolves
# ALLOW_LOCAL_NFT_METADATA=true
# SKIP_NFT_METADATA_PREFLIGHT=true
